[Unit]
Description=Publish tokens.micr.dev data from local and Tailscale machine histories
Wants=network-online.target
After=network-online.target
# Retries come from the timer's next tick. A start limit here would count
# manual runs too and could make systemd refuse the scheduled run.
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/tokens-publish/repo
Environment=HOME=%h
Environment=PATH=%h/.nvm/versions/node/v24.13.0/bin:%h/.bun/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bun scripts/auto-publish-web.ts
# A hung run would otherwise stay "activating" forever and swallow every later
# timer tick. Each step inside the script is also bounded.
TimeoutStartSec=50min
